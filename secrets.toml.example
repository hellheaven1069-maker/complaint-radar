# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# If present, these REPLACE the demo accounts.
[users.regulator]
password = "choose-a-strong-password"
role = "Regulator"
name = "Your Name"

[users.analyst]
password = "another-password"
role = "Analyst"
name = "Analyst Name"
